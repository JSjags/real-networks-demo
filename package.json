{
  "name": "order-42-offline-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Live demo for GDG Umuahia: offline-first, real-time patterns — Ada & Chidi, order #42",
  "type": "module",
  "scripts": {
    "demo": "npm install && npm run build:shared && concurrently -k -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "server": "tsx watch server/index.ts",
    "client": "vite --host 0.0.0.0 --port 5173",
    "build:shared": "tsc -p shared/tsconfig.json --outDir shared/dist || true",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "preview": "vite preview --host 0.0.0.0 --port 5173"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "express": "^4.21.2",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5"
  }
}
